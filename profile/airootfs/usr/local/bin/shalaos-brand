#!/usr/bin/env bash
# ShalaOS kimligi: filesystem/glibc paketleri kurulduktan sonra pacman hook'u
# olarak calisir (bkz. /etc/pacman.d/hooks/zz01-shalaos-branding.hook).
# os-release paket sahibi oldugu icin airootfs'ten dogrudan ezilemez; burada yazilir.
set -euo pipefail

cat > /usr/lib/os-release <<'EOF'
NAME="ShalaOS"
PRETTY_NAME="ShalaOS"
ID=shalaos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;228;20;30"
HOME_URL="https://github.com/edizsale/shalaos"
LOGO=shalaos
EOF

if command -v locale-gen >/dev/null 2>&1; then
    locale-gen
fi

# Paket sahibi yollara airootfs'ten dogrudan dosya konamaz (pacman "exists in
# filesystem" ile durur); ShalaOS ayarlari paketler kurulduktan sonra buradan yazilir.
if [ -d /usr/local/share/shalaos/calamares ]; then
    mkdir -p /etc/calamares
    cp -rT /usr/local/share/shalaos/calamares /etc/calamares
fi
if [ -f /usr/local/share/shalaos/watermark.png ] && [ -d /usr/share/plymouth/themes/spinner ]; then
    install -m644 /usr/local/share/shalaos/watermark.png /usr/share/plymouth/themes/spinner/watermark.png
fi
